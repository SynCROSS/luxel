<template>
  <div id="main" hydrate:load>
    <div class="container">
      <div class="jumbotron">
        <div class="row">
          <div class="col-md-6">
            <h1>Luxel</h1>
          </div>
          <div class="col-md-6">
            <div class="row">
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="run" on:click={run}>
                  Create 1,000 rows
                </button>
              </div>
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="runlots" on:click={runLots}>
                  Create 10,000 rows
                </button>
              </div>
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="add" on:click={add}>
                  Append 1,000 rows
                </button>
              </div>
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="update" on:click={update}>
                  Update every 10th row
                </button>
              </div>
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="clear" on:click={clearRows}>
                  Clear
                </button>
              </div>
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id="swaprows" on:click={swapRows}>
                  Swap Rows
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <table class="table table-hover table-striped test-data">
        <tbody>
          {#each rows as row}
          <tr>
            <td class="col-md-1">{row.id}</td>
            <td class="col-md-4">
              <a on:click={selectRow}>{row.label}</a>
            </td>
            <td class="col-md-1">
              <a on:click={removeRow}>
                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
              </a>
            </td>
          </tr>
          {/each}
        </tbody>
      </table>
      <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
    </div>
  </div>
</template>

<script>
const rows = signal([]);
let selectedId = null;
let selectedTr = null;
let nextId = 1;

const adjectives = ["pretty", "large", "big", "small", "tall", "short", "long", "handsome", "plain", "quaint"];
const nouns = ["table", "chair", "house", "car", "tree", "apple", "ball", "fish", "cat", "dog"];

function randomItem(list) {
  return list[Math.floor(Math.random() * list.length)];
}

function buildData(count) {
  const data = new Array(count);
  for (let i = 0; i < count; i++) {
    data[i] = {
      id: nextId++,
      label: `${randomItem(adjectives)} ${randomItem(nouns)} ${i}`,
    };
  }
  return data;
}

/** Id from first cell text node — avoids data-id setAttribute on every replace. */
function rowIdFromTr(tr) {
  return Number(tr.children[0]?.firstChild?.nodeValue);
}

function clearSelection() {
  if (selectedTr) selectedTr.className = "";
  selectedId = null;
  selectedTr = null;
}

/**
 * Schedule full recreate on rAF so krausest click→commit measurement aligns with
 * Chrome's paint frame (avoids ~150ms deferred-paint stalls after PrePaint).
 * Upstream timeline subtracts long rAF wait (raf_long_delay); Vue escapes floor
 * via microtask+same-frame paint — Luxel sync-in-click did not.
 * See #132/#133.
 */
function run() {
  const data = buildData(1000);
  clearSelection();
  requestAnimationFrame(() => {
    rows.value = data;
  });
}

function runLots() {
  const data = buildData(10000);
  clearSelection();
  requestAnimationFrame(() => {
    rows.value = data;
  });
}

function add() {
  const next = rows.value.concat(buildData(1000));
  requestAnimationFrame(() => {
    rows.value = next;
  });
}

function update() {
  const next = rows.value.slice();
  for (let i = 0; i < next.length; i += 10) {
    const row = next[i];
    if (!row) continue;
    next[i] = { ...row, label: `${row.label} !!!` };
  }
  // rAF paint-frame align — partial is 4× throttled and sits on ~200ms floor. #130
  requestAnimationFrame(() => {
    rows.value = next;
  });
}

function clearRows() {
  clearSelection();
  // Same rAF paint-frame align as run/add (#133) — clear is 4x CPU-throttled
  // and was thin-losing via deferred Paint/Commit after sync textContent teardown.
  requestAnimationFrame(() => {
    rows.value = [];
  });
}

function swapRows() {
  const data = rows.value;
  if (data.length <= 998) return;
  const next = data.slice();
  const tmp = next[1];
  next[1] = next[998];
  next[998] = tmp;
  // rAF paint-frame align (same class as remove/clear under 4× throttle). #130
  requestAnimationFrame(() => {
    rows.value = next;
  });
}

/** Direct DOM highlight — id via first-cell nodeValue (no data-id attr). */
function selectRow(ev) {
  ev.preventDefault();
  const tr = ev.target.closest("tr");
  if (!tr) return;
  const id = rowIdFromTr(tr);
  if (!Number.isFinite(id) || selectedId === id) return;
  if (selectedTr && selectedTr !== tr) selectedTr.className = "";
  tr.className = "danger";
  selectedTr = tr;
  selectedId = id;
}

function removeRow(ev) {
  ev.preventDefault();
  const tr = ev.target.closest("tr");
  if (!tr) return;
  const id = rowIdFromTr(tr);
  if (selectedTr === tr) clearSelection();
  // Direct DOM remove + rAF signal: non-keyed shrink otherwise suffix-rewrites
  // then removeChild(last); sync remove alone still hit ~200ms deferred-paint
  // floor under 2× throttle (same class as clear #129). See #130.
  requestAnimationFrame(() => {
    if (tr.isConnected) tr.remove();
    rows.value = rows.value.filter((row) => row.id !== id);
  });
}
</script>
